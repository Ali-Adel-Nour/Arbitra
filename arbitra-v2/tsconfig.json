{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node"
  },
  "include": [
    "./scripts",
    "./test",
    "./hardhat.config.ts",
    "./backend",
    "./mcp"
  ],
  "exclude": ["node_modules"]
}
